# Copy to .env and fill in, or export in your shell. .env is git-ignored.
# The tool reads MISTRAL_API_KEY from the environment; it never writes it to disk.

MISTRAL_API_KEY=

# Optional: override the chat completions endpoint (a proxy, a gateway, a local mock).
# MISTRAL_BASE_URL=https://api.mistral.ai/v1/chat/completions
